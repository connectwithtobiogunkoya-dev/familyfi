# FamilyFi server settings: the names only, never the values.
# Copy this file to .env.local on your own computer and fill in each value
# there. .env.local is never committed. On Vercel, add the same names under
# Project Settings, Environment Variables.

# The Supabase project address, from Supabase: Project Settings, Data API.
SUPABASE_URL=

# The Supabase secret key (starts sb_secret_). Server only, never shared.
SUPABASE_SECRET_KEY=

# Money movement switch: on only when exactly true. Anything else is off.
WRITES_ENABLED=

# Sign-up switch: on only when exactly true. Anything else is off.
SIGNUPS_ENABLED=

# Locks access codes: 64 hexadecimal characters. Keep a safe copy:
# losing it means access codes can no longer be shown to their owners.
ACCESS_CODE_ENCRYPTION_KEY=

# Makes visitor fingerprints for the sign-up and sign-in limits:
# 64 hexadecimal characters.
VISITOR_HASH_KEY=
